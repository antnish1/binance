APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Market
BINANCE_SYMBOL=BTCUSDT
MARKET_STALE_AFTER_MS=5000

# Binance Spot production endpoints
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws

# Set these ONLY in your cloud provider's encrypted environment variables.
# Never paste real values into this repository.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Hard safety gate. Live order execution is not implemented in Phase 0–3.
TRADING_ENABLED=false
