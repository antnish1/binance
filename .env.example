APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Market
BINANCE_SYMBOL=BTCUSDT
BINANCE_BASE_ASSET=BTC
BINANCE_QUOTE_ASSET=USDT
MARKET_STALE_AFTER_MS=5000
PORTFOLIO_RECONCILE_SECONDS=60

# Binance Spot production endpoints
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
BINANCE_WS_API_URL=wss://ws-api.binance.com:443/ws-api/v3

# Set these ONLY in your cloud provider's encrypted environment variables.
# Never paste real values into this repository.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Deterministic risk limits. Conservative placeholders only.
RISK_MAX_ORDER_NOTIONAL=25
RISK_MAX_POSITION_NOTIONAL=100
RISK_MAX_DAILY_LOSS=10
RISK_MAX_OPEN_ORDERS=3
RISK_MAX_ORDERS_PER_MINUTE=10

# Paper execution. All values are simulated only.
PAPER_STARTING_QUOTE_BALANCE=1000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=2

# Short-window high-frequency recording/replay. /tmp remains intentionally ephemeral.
RECORDING_ENABLED=true
RECORDING_MAX_EVENTS=100000
RECORDING_PATH=/tmp/binance-market.jsonl
REPLAY_MAX_EVENTS=50000

# Phase 13 sampled multi-day research dataset.
# On Railway, attach a persistent volume mounted at /data and use /data/taddy-research.
RESEARCH_DATASET_ENABLED=true
RESEARCH_DATASET_DIR=/data/taddy-research
RESEARCH_SAMPLE_INTERVAL_MS=1000
RESEARCH_MAX_SAMPLES=250000

# Automation remains paper-only.
AUTOMATION_ENABLED=false
AUTOMATION_QUANTITY=0.0001
AUTOMATION_THRESHOLD_BPS=20
AUTOMATION_LOOKBACK=50
AUTOMATION_COOLDOWN_SECONDS=30

# Hard safety gate. Live Binance order execution is still not implemented.
TRADING_ENABLED=false
